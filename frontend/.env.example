# Vite only exposes env vars prefixed with VITE_ to client code.
# Every value here must describe the SAME deployment as api/.env and
# indexer/.env — otherwise the dApp reads one chain from the API and sends
# transactions to another.

# Base URL of the Express API in /api (api/.env PORT).
VITE_API_BASE_URL=http://localhost:4000

# 31337 = local Hardhat node, 11155111 = Sepolia.
VITE_CHAIN_ID=31337

# Contract addresses (scripts/deploy.ts output). Omit to use the local
# Hardhat defaults below.
VITE_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
VITE_VOTING_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
VITE_PROOFS_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# IPFS gateway host used for "Inspect Evidence" links.
VITE_PINATA_GATEWAY=gateway.pinata.cloud
